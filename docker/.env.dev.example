# docker/.env.dev.example — required environment variables for docker-compose.dev.yml
#
# Copy this file to docker/.env.dev (or docker/.env) and fill in real values
# before running `docker compose -f docker-compose.dev.yml up`.
#
# NEVER commit the filled-in copy. Add docker/.env.dev to .gitignore.
#
# Required:
#   LGB_AUTH_JWTSECRET  — JWT signing key. Generate with `openssl rand -hex 32`.
# Optional (dev defaults are wired into docker-compose.dev.yml):
#   LGB_AUTH_ADMIN_USER     — defaults to `admin` in the dev compose.
#   LGB_AUTH_ADMIN_PASSWORD — defaults to `changeme-dev` ONLY in the dev
#                             compose. NEVER use that value outside dev.
#
# Note on the env var name: the loader (internal/config/loader.go) accepts
# both LGB_AUTH_JWTSECRET and the spelling LGB_AUTH_JWT_SECRET for backward
# compatibility with the documentation spelled out before #65.

# JWT signing key used by the gateway. Required — set a value before running.
# Generate one with: openssl rand -hex 32
# Do NOT commit the filled-in copy. Do NOT reuse any test value in production.
LGB_AUTH_JWTSECRET=

# Admin user created on first run when the user store is empty.
# Override only for local development. Defaults in docker-compose.dev.yml:
#   LGB_AUTH_ADMIN_USER=admin
#   LGB_AUTH_ADMIN_PASSWORD=changeme-dev
# On first run, if `users.db` already exists in the lgb-data volume, the
# wizard is skipped — run `docker compose -f docker-compose.dev.yml down -v`
# to reset.
LGB_AUTH_ADMIN_USER=
LGB_AUTH_ADMIN_PASSWORD=