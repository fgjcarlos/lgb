# docker/Dockerfile.dev — development image with live-reload via air.
#
# Single-stage image based on golang:1.24-alpine. The workspace is mounted
# at /workspace so code changes are reflected immediately. Not shipped to
# production — only used by docker-compose.dev.yml for the gateway service.
#
# Requirements: MVP-FND-9.1. Design: §13.3.
# Usage: docker compose -f docker-compose.dev.yml up
#
# Onboarding order (fix for #65):
#   1. `cp docker/.env.dev.example docker/.env.dev` and fill in LGB_AUTH_JWTSECRET
#      (also accepted: LGB_AUTH_JWT_SECRET — see internal/config/loader.go).
#   2. `cd frontend && npm ci && npm run build && cd -` — gateway go:embeds
#      frontend/dist at compile time, so a fresh dev start requires a built SPA
#      or `mountSPA` will skip the catch-all and `/` returns 404.
#   3. `docker compose -f docker-compose.dev.yml up gateway`
#   4. If `users.db` already exists from a previous run, the admin wizard is
#      skipped. To reset: `docker compose -f docker-compose.dev.yml down -v`.
#
FROM golang:1.24-alpine

# Install air for live-reload. Pinned via go install to a stable release that
# supports the long-form --build.* flags (air >= 1.52). Update as needed.
RUN go install github.com/air-verse/air@latest

WORKDIR /workspace

# Use air to watch for Go source changes and rebuild/restart automatically.
# Migrated to the long-form --build.cmd / --build.entrypoint shape in #65 —
# Air 1.52+ deprecated the single-dash -build.cmd / -build.bin shorthand and
# silently falls back to ./tmp/main when those flags are unrecognised, which
# is what produced the `/workspace/tmp/main: not found` error.
#
# --build.exclude_dir keeps node_modules / build artefacts out of the watcher
# (go:embed will not recompile when those files change, but watching them
# still wastes CPU).
CMD ["air", \
     "--build.cmd", "go build -tags no_embed -o ./bin/lgb ./cmd/lgb", \
     "--build.entrypoint", "./bin/lgb", \
     "--build.exclude_dir", "tmp,bin,frontend/node_modules,site/node_modules,frontend/dist", \
     "--", "server", "--config", "docker/lgb.dev.yaml"]